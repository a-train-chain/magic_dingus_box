# EmbedTubeShaders.cmake - the Tube renderer's GLSL files (src/tube/shaders/) into
# one generated header, tube/tube_shader_sources.h, at CONFIGURE time.
#
# Why generated, not hand-written R"(...)" strings as renderer_shaders.cpp does:
# CI runs glslangValidator on the very sources the kiosk embeds, and that needs
# them as files. Each file becomes one `inline constexpr std::string_view` in
# namespace tube::glsl, a raw string with the delimiter `tube_glsl`; a file that
# contains the closing sequence fails the configure rather than the compile.
#
# Every file is a CMAKE_CONFIGURE_DEPENDS, so editing a shader re-runs the
# configure (and this) on the next build. The header is rewritten only when its
# contents change, so an unrelated re-configure recompiles nothing.
#
#   embed_tube_shaders(<shader dir> <output header>)

function(embed_tube_shaders shader_dir out_header)
    # <file>:<C++ name>, in the order the header declares them.
    set(entries
        common.glsl:common
        fullscreen.vert:fullscreen_vert
        glass.frag:glass
        quarter.frag:quarter
        blur.frag:blur
        copy_encode.frag:copy_encode
        signal.frag:signal
        lines.frag:lines
        output.frag:output)

    set(body "")
    foreach(entry IN LISTS entries)
        string(REPLACE ":" ";" pair "${entry}")
        list(GET pair 0 file)
        list(GET pair 1 name)
        set(path "${shader_dir}/${file}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Tube shader missing: ${path}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" text)
        string(FIND "${text}" ")tube_glsl\"" closes)
        if(NOT closes EQUAL -1)
            message(FATAL_ERROR "Tube shader ${path} contains the raw-string delimiter )tube_glsl\"")
        endif()
        string(APPEND body "// ${file}\n")
        string(APPEND body "inline constexpr std::string_view ${name} = R\"tube_glsl(")
        string(APPEND body "${text}")
        string(APPEND body ")tube_glsl\";\n\n")
    endforeach()

    # Built by APPEND, quoted: a CMake list would split the GLSL at every ';'.
    set(header "")
    string(APPEND header
        "// GENERATED by cmake/EmbedTubeShaders.cmake from src/tube/shaders/ - do not edit.\n"
        "// The Tube renderer's GLSL, one string per file; tube_shader_assembly.h puts\n"
        "// each program together from them.\n"
        "#pragma once\n\n"
        "#include <string_view>\n\n"
        "namespace tube::glsl {\n\n")
    string(APPEND header "${body}")
    string(APPEND header "}  // namespace tube::glsl\n")

    set(staged "${out_header}.staged")
    file(WRITE "${staged}" "${header}")
    configure_file("${staged}" "${out_header}" COPYONLY)
    file(REMOVE "${staged}")
endfunction()
