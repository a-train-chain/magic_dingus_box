[Unit]
Description=Pin all CPU cores to the performance governor
# Run early so the kiosk service starts with max clocks already set
Before=magic-dingus-box-cpp.service
DefaultDependencies=no
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -w "$g" ] && echo performance > "$g"; done'

[Install]
WantedBy=multi-user.target
