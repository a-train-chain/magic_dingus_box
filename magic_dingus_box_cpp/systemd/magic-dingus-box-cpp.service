[Unit]
Description=Magic Dingus Box C++ Kiosk Engine
# Phone Remote: web service creates /dev/uinput's virtual gamepad eagerly
# at startup, so the kiosk must boot AFTER it for the kiosk's input scan
# to find the virtual gamepad. Without this, the phone remote silently
# does nothing because the kiosk never reads the device.
# NOTE: network-online.target is intentionally in Wants= but NOT After=.
# The kiosk UI, game emulation, and playlist video playback need NO network
# to start — only the Media Browser's TMDB/Radarr calls do, and those are
# lazy (clients connect on first use, VpnHealthMonitor polls on its own
# thread). Ordering the kiosk After=network-online blocked its start ~14s
# on NetworkManager-wait-online (measured), leaving the screen black that
# whole time. Keeping network-online in Wants= still pulls the network up
# in parallel, so it's ready by the time the operator opens the Media
# Browser — the menu just appears ~10s sooner. magic-dingus-web.service
# STAYS in After= (below): the phone-remote virtual gamepad must exist
# before the kiosk's input scan (see note above), and that service starts
# fast without waiting on network.
After=systemd-user-sessions.service sound.target magic-dingus-web.service
Wants=network-online.target sound.target magic-dingus-web.service
# Start early, before X11 (we use DRM/KMS directly)
Before=graphical.target lightdm.service
# Don't require X11 - we bypass it entirely
Conflicts=lightdm.service
# Restart-rate limiting (these belong in [Unit], not [Service] — systemd
# accepts them in [Service] silently in some versions but logs an
# "Unknown key" warning on every daemon-reload).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
# Run as magic user (member of video group)
User=magic
Group=magic
# Working directory where executable and assets are located
# Adjust this path to match your installation location
WorkingDirectory=/opt/magic_dingus_box/magic_dingus_box_cpp/build
# Wait for HDMI audio and start PulseAudio
ExecStartPre=/bin/bash /opt/magic_dingus_box/magic_dingus_box_cpp/scripts/init_audio.sh
ExecStart=/opt/magic_dingus_box/magic_dingus_box_cpp/build/magic_dingus_box_cpp
ExecStopPost=/usr/bin/pulseaudio --kill
# Restart policy:
#   - on-failure: covers segfaults, asserts, and watchdog timeouts. RetroArch
#     integration is unaffected — the kiosk waitpid()'s on RetroArch and
#     returns through normal control flow, so a clean exit (status 0 / 75)
#     is not a "failure" and won't trigger a restart loop.
#   - WatchdogSec=10 is the "frozen render loop" trigger; the watchdog
#     timing out is itself classified as a failure, so restarting
#     on-failure handles both cases with one rule. Was briefly bumped to
#     30s in v1.7.x as a band-aid for the synchronous Radarr interactive-
#     search call from the manual release picker (14-25s round-trip).
#     The picker is now fully async (worker thread + state machine — see
#     ReleasePickerScreen::load_async), so the main render loop never
#     blocks on Radarr and the original 10s budget is back in force.
#   - StartLimitBurst caps how often we try (5 attempts in 5 minutes) so a
#     repeatedly-crashing build doesn't churn forever.
Restart=on-failure
RestartSec=5
# Standard output/error logging
StandardOutput=journal
StandardError=journal
# Environment (if needed)
Environment=HOME=/home/magic
Environment=DISPLAY=
Environment=XDG_RUNTIME_DIR=/run/user/1000
# API keys for Radarr / Prowlarr / qBittorrent are written to
# services/.env by setup_services.sh (or copied from a clone source).
# The kiosk binary reads RADARR_API_KEY / PROWLARR_API_KEY (with optional
# MDB_-prefixed overrides) at startup. The leading `-` makes the
# EnvironmentFile optional so unprovisioned Pis (no .env yet) still
# boot the kiosk cleanly — the Media Browser just shows "key not
# configured" banners for affected rows.
EnvironmentFile=-/opt/magic_dingus_box/services/.env
# --- Scheduling priority for smooth video playback ---
# Pi 4B: 1.6 GB RAM + 4 cores, shared with Docker stack (Radarr,
# Prowlarr, qBit, Byparr, Gluetun) and PulseAudio. Without explicit
# priority the kiosk's render thread can be preempted by background
# work (Prowlarr index sync, Radarr metadata fetch, etc.) mid-frame,
# producing visible stutter on 1080p H.264 playback even though the
# v4l2h264dec hardware decoder is keeping up. Three-layer priority:
#
#   - Nice=-10 lifts the kiosk above default-niceness siblings in the
#     CFS scheduler. -10 is conservative (PulseAudio at -5 still beats
#     us for audio servicing); going lower (-15+) starves the I/O
#     waiters in the kernel mutexes.
#   - CPUWeight=1000 (cgroup v2) gives the kiosk's cgroup 10× the CPU
#     allocation of default-weight (100) cgroups when under contention.
#     Docker containers default to ~100, so under simultaneous load
#     the kiosk wins by a 10:1 ratio.
#   - IOWeight=1000 (cgroup v2) same idea for block I/O — keeps disk
#     reads for the movie file ahead of background torrent / DB writes.
Nice=-10
CPUWeight=1000
IOWeight=1000

# Kill all processes in the service's cgroup on stop
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5
WatchdogSec=10

[Install]
# Start at multi-user target (before X11)
WantedBy=multi-user.target
