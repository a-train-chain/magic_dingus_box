[Unit]
Description=Magic Dingus Box — resync qBittorrent password to .env on boot
ConditionPathExists=/opt/magic_dingus_box/services/.env
# Must run after the stack is up so qBit's WebUI is reachable.
After=magic-dingus-services.service
Requires=magic-dingus-services.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sync_qbit_password.sh
StandardOutput=journal
StandardError=journal
Restart=no
# Long enough for qBit's worst-case cold-start (~90s) + the curl
# auth dance. Anything longer than this means qBit itself is broken
# and we shouldn't keep boot waiting.
TimeoutSec=180

[Install]
WantedBy=multi-user.target
