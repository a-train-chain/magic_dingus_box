  {
    "id": 9,
    "name": "Non-English title signals",
    "includeCustomFormatWhenRenaming": false,
    "specifications": [
      {
        "name": "Non-Latin script or foreign-dub keyword",
        "implementation": "ReleaseTitleSpecification",
        "implementationName": "Release Title",
        "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
        "negate": false,
        "required": true,
        "fields": [
          {
            "order": 0,
            "name": "value",
            "label": "Regular Expression",
            "helpText": "Custom Format RegEx is Case Insensitive \u2014 rejects releases whose TITLE advertises a foreign dub or a multi-audio/dual-audio pack, plus any title carrying non-Latin script (Cyrillic, CJK, Korean). This is layer 2 of the English-audio rule; layer 1 is \"Release language is not the original\". Layer 2 is required because the parser can tag a MULTi release as English \u2014 i.e. as the Original \u2014 and sail through layer 1: observed live with 'Game Of Thrones S03 MULTi (1080p) BluRay x264 PopHD' (French audio) and with '\u0414\u044c\u044f\u0432\u043e\u043b \u043d\u043e\u0441\u0438\u0442 Prada 2 / The Devil Wears Prada 2'. Bare single-language tokens (FRENCH, ITA, GERMAN) are deliberately NOT listed: on a foreign film they mark the ORIGINAL audio, which must stay downloadable, and layer 1 already rejects them on English-original content.",
            "value": "[\u0400-\u04ff\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]|\\b(dublado|doblado|castellano|latino|latam|dubbed|brazilian[. ]?dub|french[. ]?dub|german[. ]?dub|italian[. ]?dub|russian[. ]?dub|spanish[. ]?dub|chinese[. ]?dub|japanese[. ]?dub|korean[. ]?dub|dual[. _-]?audio|multi[. _-]?(audio|lang|langs|language|languages)|truefrench|vostfr|subfrench|vf[fqib]|german[. _-]?dl)\\b|\\bmulti\\b(?![. _-]?subs?\\b)|\\b(ita|eng|fre|fra|ger|deu|spa|rus|jpn|kor|hin|tam|tel)[. _+/-](ita|eng|fre|fra|ger|deu|spa|rus|jpn|kor|hin|tam|tel)\\b",
            "type": "textbox",
            "advanced": false,
            "privacy": "normal",
            "isFloat": false
          }
        ]
      }
    ]
  },
