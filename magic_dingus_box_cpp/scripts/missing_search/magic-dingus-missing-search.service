[Unit]
Description=Magic Dingus Box — re-search monitored movies still missing a file
After=magic-dingus-services.service
Requires=docker.service
ConditionPathExists=/opt/magic_dingus_box/services/.env

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/magic_dingus_box/magic_dingus_box_cpp/scripts/missing_search/missing_search.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
