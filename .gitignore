# OS files
.DS_Store

# Editor
*.swp
.idea/
.vscode/

# Runtime-only: exclude docs and markdown from repo (keep root README.md and CLAUDE.md)
docs/
# Markdown: exclude all except specific root-level files and test suite
*.md
!README.md
!CLAUDE.md
!CHANGELOG.md
# DO track design specs + implementation plans — they're versioned
# design history, not runtime reference docs. Specs and plans land in
# docs/superpowers/{specs,plans}/ via the superpowers brainstorming +
# writing-plans skills before each implementation cycle.
# (These re-includes go AFTER the *.md rule so they take effect over it.)
!docs/
!docs/superpowers/
!docs/superpowers/specs/
!docs/superpowers/specs/**.md
!docs/superpowers/plans/
!docs/superpowers/plans/**.md
# Operator-facing setup doc — must be tracked so README can link to it.
!magic_dingus_box_cpp/docs/MEDIA_BROWSER_VPN_SETUP.md
!OTA_UPDATE_GUARANTEES.md
!magic_dingus_box_cpp/README.md
!tests/README.md
!tests/**/*.md
!tests/*.md

# Test data/large binaries only (not the test suite itself)
magic_dingus_box/web/test_files/

# Worktrees
.worktrees/

# Local Mac build tree for Media Browser dev
build-mac/
build-test/

# Media Browser V2 — service secrets (never commit)
magic_dingus_box_cpp/services/.env

# Superpowers brainstorming session content (transient mockups)
.superpowers/

# Local Claude Code state — not for the repo
.claude/
